rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/records/{recordId} {
      function owner() {
        return request.auth != null
          && request.auth.uid == uid
          && uid == 'REPLACE_WITH_OWNER_UID';
      }
      allow read: if owner();
      allow create, update: if owner()
        && request.resource.data.keys().hasOnly(['kind', 'id', 'payload'])
        && request.resource.data.kind in ['subjects', 'sessions']
        && request.resource.data.id is string
        && (request.resource.data.payload == null || request.resource.data.payload is string);
    }
  }
}
